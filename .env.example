# ==============================================================================
# Safety Facility App - Docker & Global Environment Template (Copy to .env)
# ==============================================================================

# MongoDB Configuration
MONGO_EXTERNAL_PORT=27017
MONGO_URI=mongodb://mongo:27017/safety_facilities

# Backend Configuration
BACKEND_PORT=5000
BACKEND_EXTERNAL_PORT=5050

# Frontend Configuration
FRONTEND_PORT=80
FRONTEND_EXTERNAL_PORT=8090

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Registration/Login Configuration
ALLOWED_EMAIL_DOMAIN=@korea.kr
EXTERNAL_API_KEY=sag_external_secret

# SMTP Email Configuration (For Verification / Password Reset / OTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Safety Facility App <noreply@safetyfacility.com>"

# URLs for Link Generation (Docker Compose defaults)
FRONTEND_URL=http://localhost:8090
BACKEND_URL=http://localhost:5050

