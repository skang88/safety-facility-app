# ==============================================================================
# Safety Facility App - Backend Configuration Template (Copy to .env)
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/safety_facilities

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Registration/Login Configuration
ALLOWED_EMAIL_DOMAIN=@korea.kr
EXTERNAL_API_KEY=sag_external_secret

# SMTP Email Configuration (For Verification / Password Reset / OTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Safety Facility App" <noreply@safetyfacility.com>

# URLs for Link Generation
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

